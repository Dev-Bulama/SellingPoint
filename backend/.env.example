APP_NAME=Sellingpoint
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# IMPORTANT: Set to your actual server IP or domain for mobile to access images
# For local dev with physical device: APP_URL=http://192.168.x.x:8000
# For production: APP_URL=https://yourdomain.com
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ───────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sellingpoint
DB_USERNAME=root
DB_PASSWORD=

# ── Session / Cache / Queue ───────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Mail ───────────────────────────────────────────────────────────────────────
# For production use smtp. For local dev, 'log' writes to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sellingpoint.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Paystack ──────────────────────────────────────────────────────────────────
# Get your keys from https://dashboard.paystack.com/#/settings/developer
# Use test keys for development, live keys for production
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# ── OneSignal Push Notifications ──────────────────────────────────────────────
# Get from https://app.onesignal.com → Your App → Settings → Keys & IDs
ONESIGNAL_APP_ID=your-onesignal-app-id-here
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# For local development with mobile emulator, keep '*'
# For production, set to your actual domain(s)
CORS_ALLOWED_ORIGINS=*

# ── Sanctum ───────────────────────────────────────────────────────────────────
# Add your frontend domains here (comma-separated)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# ── AWS / S3 (optional — use for file storage in production) ──────────────────
# If not using S3, leave blank. Files are stored locally under storage/app/public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
